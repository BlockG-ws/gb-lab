# .env.example - example environment variables for this project
# Copy to .env and fill values before running

########################
# Database (drizzle)
########################
# Use 'sqlite' (default) or 'postgresql'
DB_TYPE=sqlite

# If using PostgreSQL, configure these (example values):
#DB_TYPE=postgresql
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=activitypub
#DB_USER=postgres
#DB_PASSWORD=secret

# If using SQLite, specify path to DB file (default: ./data/activitypub.db)
DB_PATH=./data/activitypub.db

########################
# Site / Content
########################
# Optional global content password (used by protected content). Any string is accepted.
CONTENT_PASSWORD=p1easeChangeMe!

########################
# ActivityPub / Fediverse
########################
# Your instance domain (used to build actor URLs). Example: example.com
ACTIVITYPUB_DOMAIN=lab.gb0.dev
# Optional: override base url (automatically derived from domain if empty)
#ACTIVITYPUB_BASE_URL=https://lab.gb0.dev

# Local actor settings (used to create the actor if missing)
ACTIVITYPUB_USERNAME=grassblock
ACTIVITYPUB_NAME="GrassBlock"
ACTIVITYPUB_SUMMARY="A blog about technology and life"
ACTIVITYPUB_ICON=/img/avatar.png
ACTIVITYPUB_IMAGE=/img/blog-cover.png

# RSA keypair for signing outgoing ActivityPub requests
# Recommended: place PEM values on a single line with literal \n for newlines
# Example (single-line with escaped newlines):
# ACTIVITYPUB_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkq...\n-----END PUBLIC KEY-----"
# ACTIVITYPUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...\n-----END PRIVATE KEY-----"
ACTIVITYPUB_PUBLIC_KEY=
ACTIVITYPUB_PRIVATE_KEY=

# Federation toggles and lists
# Set to 'false' to disable federation features
ACTIVITYPUB_FEDERATION_ENABLED=true
# Comma-separated lists of domains, e.g. example.org,instance.example
ACTIVITYPUB_ALLOW_LIST=
ACTIVITYPUB_BLOCK_LIST=

########################
# Mastodon / fediverse helper
########################
# Optional read/search token for Mastodon-compatible instances (used by comments/fediverse features)
MASTODON_API_TOKEN=

########################
# Elog integrations (used by scripts/elog.config.js)
########################
# Yuque
YUQUE_TOKEN=
YUQUE_LOGIN=
YUQUE_REPO=
YUQUE_USERNAME=
YUQUE_PASSWORD=

# Notion (for elog deploy/write)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Feishu
FEISHU_WIKI_ID=
FEISHU_FOLDER_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Flowus
FLOWUS_TABLE_PAGE_ID=

# Halo integration
HALO_ENDPOINT=
HALO_TOKEN=
HALO_POLICY_NAME=

# Confluence / WordPress deploy
CONFLUENCE_USER=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_ROOT_PAGE_ID=
WORDPRESS_USERNAME=
WORDPRESS_PASSWORD=
WORDPRESS_ENDPOINT=

########################
# Object storage / image upload
########################
# Alibaba OSS
OSS_SECRET_ID=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_REGION=
OSS_HOST=

# Tencent COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_HOST=

# Qiniu
QINIU_SECRET_ID=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_REGION=
QINIU_HOST=

# UpYun
UPYUN_USER=
UPYUN_PASSWORD=
UPYUN_BUCKET=
UPYUN_HOST=

########################
# GitHub (elog image upload / repo deploy)
########################
GITHUB_TOKEN=
ELOG_GITHUB_USER=
ELOG_GITHUB_REPO=

########################
# Misc / optional
########################
# If you use any other integrations (analytics, comment providers, etc.) add their tokens here.

# Example: Umami site id / domain (configured in src/config.ts)
# UMAMI_INSTANCE_DOMAIN=umami.yourdomain.com
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# End of .env.example

